diff --git a/supabase/migrations/20260926120000_device_bound_reset_links.sql b/supabase/migrations/20260926120000_device_bound_reset_links.sql
new file mode 100644
index 0000000..6398a43
--- /dev/null
+++ b/supabase/migrations/20260926120000_device_bound_reset_links.sql
@@ -0,0 +1,24 @@
+-- Reset links that only work on the device that asked for them.
+--
+-- Every sending service keeps a copy of what it sent, and anyone who can read
+-- those logs could otherwise open a reset link and take the account. So a
+-- reset needs two halves that never travel together:
+--
+--   token        in the emailed link; only its SHA-256 is stored here.
+--   device key   kept on the device that asked; only its SHA-256 is stored.
+--
+-- auth-reset completes a reset only with both, within the hour, once, and at
+-- most a few wrong device keys per link. Service role only.
+
+create table if not exists public.reset_tickets (
+  token_hash   text primary key,
+  profile_id   uuid not null references public.profiles(id) on delete cascade,
+  device_hash  text not null,
+  expires_at   timestamptz not null,
+  attempts     integer not null default 0,
+  created_at   timestamptz not null default now()
+);
+create index if not exists reset_tickets_profile_idx on public.reset_tickets (profile_id);
+
+alter table public.reset_tickets enable row level security;
+revoke all on public.reset_tickets from anon, authenticated;
